# Repasse das rotas da allowlist para a API legada. Conectividade, não segurança: a API continua
# pública para quem a acessar diretamente.
proxy_pass ${API_UPSTREAM}$mm_api_caminho;
proxy_http_version 1.1;
proxy_set_header Host ${API_HOST};
proxy_set_header Connection "";

# Nada de credenciais ou origem do navegador chega ao backend.
proxy_set_header Cookie "";
proxy_set_header Authorization "";
proxy_set_header Origin "";
proxy_hide_header Set-Cookie;

# TLS para upstream https (SNI com o host da API).
proxy_ssl_server_name on;
proxy_ssl_name ${API_HOST};

# Prazos coerentes com o cliente (30 s): o proxy espera um pouco mais que o navegador.
proxy_connect_timeout 10s;
proxy_send_timeout 10s;
proxy_read_timeout 35s;

include /etc/nginx/moviematch/cabecalhos.inc;
add_header Cache-Control "no-store" always;
